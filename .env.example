# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this example file is committed so every required setting is documented.

DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# Optional — defaults to a SQLite file in the project root.
# For the eventual PostgreSQL migration, set something like:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fittrack
