# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this example file is committed so every required setting is documented.

DEBUG=true

# Signs session cookies — anyone who knows this can forge a login for any
# account. Required when DEBUG is false; the app refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# How long a login lasts, in seconds. Defaults to 14 days.
# SESSION_MAX_AGE_SECONDS=1209600

# Restricts the session cookie to HTTPS. Leave false for local development
# (a secure cookie is never sent over plain HTTP); set true in production.
SESSION_HTTPS_ONLY=false

# Optional — defaults to a SQLite file in the project root.
# For the eventual PostgreSQL migration, set something like:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fittrack
