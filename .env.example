# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this example file is committed so every setting is documented. Commented
# lines show the default the app uses when the setting is left out.

DEBUG=true

# Signs session cookies — anyone who knows this can forge a login for any
# account. Required when DEBUG is false: the app refuses to start without a
# random value of at least 32 characters. Generate one, then uncomment:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Left commented on purpose: a value written here would be public.
# SECRET_KEY=

# How long a login lasts, in seconds. Defaults to 14 days.
# SESSION_MAX_AGE_SECONDS=1209600

# Restricts the session cookie to HTTPS. Leave false for local development
# (a secure cookie is never sent over plain HTTP); set true in production.
SESSION_HTTPS_ONLY=false

# Optional — defaults to a SQLite file (fittrack.db) in the project root.
# PostgreSQL needs a driver installed first (e.g. `pip install psycopg`), then:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fittrack

# Shown as the API title on /docs.
# APP_NAME=FitTrack

# --- Open Food Facts (external nutrition search; free, no key) ---
# Turn the live search off to use only the local food database (e.g. offline).
# OFF_ENABLED=true
# Identify the app to OFF; add a real contact if you run this in earnest.
# OFF_USER_AGENT=FitTrack/0.1 (you@example.com)
# Optional tuning (defaults shown). OFF's search is intermittently throttled,
# so failed requests are retried briefly before search falls back to local.
# OFF_BASE_URL=https://world.openfoodfacts.org
# OFF_TIMEOUT_SECONDS=6.0
# OFF_MAX_RETRIES=2
# OFF_RETRY_BACKOFF_SECONDS=0.25
# OFF_SEARCH_PAGE_SIZE=20

# --- Claude (AI meal ideas, photo estimates, workout ideas) ---
# Opt-in: every suggestion or estimate is a billed Anthropic API call. Needs
# both lines below; with either missing the AI features are hidden instead of
# erroring. AI_ENABLED=false also works as a kill switch that keeps the key.
# AI_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...
# Optional tuning (defaults shown):
# AI_MODEL=claude-opus-4-8
# AI_EFFORT=medium
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=1
# AI requests per user per rolling 24 hours (shared by all AI features).
# AI_DAILY_LIMIT=20
